<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Connect 는 AAOS 기반이므로 automotive 기능을 요구한다. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!--
      Vehicle State 조회 권한 (document.pleos.ai .../Vehicle/vehicle-permission).
      Vehicle SDK 퍼미션은 App Market 사전 승인 범위 내에서만 선언해야 한다.
      - CAR_DRIVE: Odometer(트립 주행 시간, 주행 가능 거리)
      - CAR_ENERGY: Fuel / EvBattery(잔량)
      - CAR_DOORS: Door(잠금 상태)
      - CAR_LIGHTS: Light(전조등 상태)
    -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!--
      Vehicle Control (CONTROL_CAR_*): 문 잠금, 전조등, 공조, 창문 제어.
      Playground 에서 "준비 중" 이므로 승인 전에는 호출이 거부될 수 있다.
    -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <!-- 음성 안내/명령, 주차 위치 (각 SDK declaring-permissions 문서 및 공식 샘플 기준) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Android 음성 인식 폴백 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- NaviHelper 경로 안내 정보 (공식 navi 샘플 manifest 기준) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="android.car.permission.CAR_DRIVING_STATE_3P" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|keyboardHidden|navigation|locale|layoutDirection|fontScale"
            android:exported="true">
            <!-- Compose redraws on these itself. Recreating would drop the trip state (rest timer,
                 demo drive) whenever the car switches day/night or the display rotates. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

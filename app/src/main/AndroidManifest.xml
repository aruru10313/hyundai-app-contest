<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Connect 는 AAOS 기반이므로 automotive 기능을 요구한다. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="android.car.permission.CAR_DRIVING_STATE_3P" />

    <!--
      Pleos 권한은 실제 기능을 붙이는 단계에서 추가한다.
      - TTS: pleos.car.permission.TTS_SERVICE
      - STT: pleos.car.permission.STT_SERVICE
      - Navi: NAVI_ROUTE / NAVI_ROUTE_SEARCH ...
      Vehicle SDK 퍼미션은 App Market 사전 승인 범위 내에서만 선언해야 한다.
    -->

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
